    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "flat-waterfall-ef3f.cloudflareaccess.com",
    "ACCESS_AUD": "d686376494e890c044bf3da68294bc09e205829cafefbb35fb865b3a1e512e30"
  }
}
